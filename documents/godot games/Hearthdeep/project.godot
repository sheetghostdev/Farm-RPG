; Engine configuration file.
; Hearthdeep — a 1-6 player cooperative farming & expedition game.

config_version=5

[application]

config/name="Hearthdeep"
config/description="A cozy shared homestead above a deep, endlessly tempting world below."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Items="*res://scripts/core/items.gd"
Meshes="*res://scripts/core/meshes.gd"
Sfx="*res://scripts/core/sfx.gd"
Game="*res://scripts/core/game.gd"
Net="*res://scripts/core/net.gd"
Zones="*res://scripts/core/zones.gd"

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/unused_signal=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/unassigned_variable=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="enemies"
3d_physics/layer_4="objects"
3d_physics/layer_5="npcs"
3d_render/layer_1="surface"
3d_render/layer_2="underground"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.07, 1)
rendering_device/fallback_to_opengl3=true

[shader_globals]

player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
wind_strength={
"type": "float",
"value": 1.0
}
snow_amount={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
leaf_density={
"type": "float",
"value": 1.0
}
season_tint={
"type": "color",
"value": Color(1, 1, 1, 0)
}
cutaway_enabled={
"type": "float",
"value": 1.0
}
